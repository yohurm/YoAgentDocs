# Python overlay — 接在 common 之后。
# .venv / .mypy_cache / .pytest_cache / .ruff_cache / .tox 等点目录已由 .*/ 覆盖。
# 不忽略 lib/（GitHub 官方 Python 模板会误伤源码）。锁文件默认跟踪。

__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
wheels/
*.manifest
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
*.mo
.Python
MANIFEST

# 虚拟环境目录名不带点时 .*/ 覆盖不到
venv/
ENV/
env/
env.bak/
venv.bak/

# 本地密钥（Streamlit 等）；.env 已在 common
.streamlit/secrets.toml
.pypirc
